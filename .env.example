# Admin account (local login — not Google)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# PostgreSQL
POSTGRES_DB=itms
POSTGRES_USER=itms_user
POSTGRES_PASSWORD=change_this_strong_password

# App
SESSION_SECRET=change_this_to_a_long_random_string_64_chars

# Google OAuth  (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost/auth/google/callback

# Domain restriction — only @bykea.com accounts can login
ALLOWED_DOMAIN=bykea.com

# This email gets Super Admin role on first login
SUPER_ADMIN_EMAIL=it@bykea.com
