# Admin account (local email + password login — this app has no Google OAuth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# PostgreSQL
POSTGRES_DB=itms
POSTGRES_USER=itms_user
POSTGRES_PASSWORD=change_this_strong_password

# App
SESSION_SECRET=change_this_to_a_long_random_string_64_chars

# ChatBot assistant (get from console.groq.com)
GROQ_API_KEY=your_groq_api_key

# Google Workspace SSO (create an OAuth client at console.cloud.google.com).
# LEAVING THESE UNSET keeps local email+password login. THE MOMENT both
# CLIENT_ID and CLIENT_SECRET are set (and the app restarted), sign-in
# switches to Google-only for everyone except the ADMIN_USERNAME account.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://your-host/auth/google/callback
# GOOGLE_ALLOWED_DOMAIN=bykea.com
